{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OOPC observable evidence-access event v1",
  "type": "object",
  "required": ["trace_version","run_id","event_id","sequence","timestamp","agent_id","operation","kind","status","release_id","retrieval_index_version","request","result_ids","traversed_edges","paths","payload_hash","duration_ms","truncated"],
  "properties": {
    "trace_version": {"const":"oopc-trace-v1"},
    "run_id": {"type":"string"},
    "event_id": {"type":"string"},
    "operation_id": {"type":"string"},
    "trace_id": {"type":"string","pattern":"^[0-9a-f]{32}$"},
    "span_id": {"type":"string","pattern":"^[0-9a-f]{16}$"},
    "sequence": {"type":"integer","minimum":1},
    "timestamp": {"type":"string","format":"date-time"},
    "agent_id": {"type":"string"},
    "operation": {"type":"string"},
    "kind": {"enum":["access","delivery","artifact","review","reuse","candidate","lifecycle"]},
    "status": {"type":"string"},
    "release_id": {"type":"string"},
    "retrieval_index_version": {"type":"string"},
    "request": {"type":"object"},
    "result_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "traversed_edges": {"type":"array","items":{"type":"string"}},
    "paths": {"type":"array","items":{"type":"object"}},
    "payload_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "duration_ms": {"type":"number","minimum":0},
    "truncated": {"type":"boolean"}
  }
}
